+fn glide_kitchen() {
+    let mut harness = crate::drive::opened("s13");
+    quiet(&mut harness);
+    let centres = crate::inspect::swatch_centres(&harness.app().windows()[0]);
+    let middle = Point::new(
+        CssPx(crate::gallery::WIDTH / 2.0),
+        CssPx(crate::gallery::HEIGHT / 2.0),
+    );
+    // The same preamble the scenario runs before the glide: tab to a field, 32 keystrokes (with
+    // the backspaces), 32 swatch clicks.
+    use zgui::vocab::{KeyCode, KeyEvent, NamedKey, PhysicalKey};
+    let (tabs, _) = crate::input::focus_a_field_timed(&mut harness);
+    let letters = ["a", "b", "c", "d", "e", "f", "g", "h"];
+    for step in 0..32 {
+        let letter = letters[step % letters.len()];
+        harness.deliver_to_first(crate::input::key(KeyEvent::character(letter)));
+        harness.settle(64);
+        harness.deliver_to_first(crate::input::key_up(KeyEvent::character(letter)));
+        harness.settle(64);
+        if step % 8 == 7 {
+            for _ in 0..8 {
+                harness.deliver_to_first(crate::input::key(KeyEvent::named(
+                    NamedKey::Backspace,
+                    PhysicalKey::Code(KeyCode::Backspace),
+                )));
+                harness.settle(64);
+                harness.deliver_to_first(crate::input::key_up(KeyEvent::named(
+                    NamedKey::Backspace,
+                    PhysicalKey::Code(KeyCode::Backspace),
+                )));
+                harness.settle(64);
+            }
+        }
+    }
+    for step in 0..32 {
+        let at = centres[step % centres.len()];
+        harness.deliver_to_first(crate::input::pointer(PointerAction::Moved, at));
+        harness.settle(64);
+        harness.deliver_to_first(crate::input::pointer(PointerAction::Pressed, at));
+        harness.settle(64);
+        harness.deliver_to_first(crate::input::pointer(PointerAction::Released, at));
+        harness.settle(64);
+    }
+    harness.deliver_to_first(crate::input::pointer(PointerAction::Moved, middle));
+    harness.settle(64);
+
+    let scale = harness.app().windows()[0].scale().get();
+    let mut tsv = String::from("notch\tlines\ttick\tcontainer\toffset_y_device_px\toffset_y_css_px\tframes_run\tboxes_rebuilt\tnodes_relaid_out\tprimitives_emitted\tgliding_after\n");
+    let mut summary = String::new();
+    for step in 0..8 {
+        let lines = if step % 2 == 0 { 3.0 } else { -3.0 };
+        let mark = zgui_profile::counter::snapshot();
+        harness.deliver_to_first(crate::input::wheel(middle, lines));
+        let settled = harness.settle(64);
+        let moved = mark.delta(&zgui_profile::counter::snapshot());
+        let (name, start) = lead(&harness);
+        let _ = writeln!(
+            tsv,
+            "{step}\t{lines}\t0\t{name}\t{start:.4}\t{:.4}\t{settled}\t{}\t{}\t{}\t{}",
+            start / scale,
+            moved.boxes_rebuilt,
+            moved.nodes_relaid_out,
+            moved.primitives_emitted,
+            u8::from(crate::input::gliding(&harness))
+        );
+        let mut carried = 0;
+        let mut frames_with_work = 0;
+        while crate::input::gliding(&harness) && carried < 60 {
+            let mark = zgui_profile::counter::snapshot();
+            harness.advance(Duration::from_micros(16_667));
+            let ran = harness.pump();
+            carried += 1;
+            if ran > 0 {
+                frames_with_work += 1;
+            }
+            let moved = mark.delta(&zgui_profile::counter::snapshot());
+            let (name, y) = lead(&harness);
+            let _ = writeln!(
+                tsv,
+                "{step}\t{lines}\t{carried}\t{name}\t{y:.4}\t{:.4}\t{ran}\t{}\t{}\t{}\t{}",
+                y / scale,
+                moved.boxes_rebuilt,
+                moved.nodes_relaid_out,
+                moved.primitives_emitted,
+                u8::from(crate::input::gliding(&harness))
+            );
+        }
+        let end = lead(&harness).1;
+        let _ = writeln!(
+            summary,
+            "notch {step} (lines {lines}): glided {carried} ticks of 16.667 ms ({frames_with_work} with a frame), offset {start:.2} -> {end:.2} device px ({:.2} css px)",
+            (end - start) / scale
+        );
+    }
+    write("glide_kitchen.tsv", &tsv);
+    write(
+        "glide_kitchen.meta.txt",
+        &format!(
+            "gallery s13 after the kitchen scenario's preamble ({tabs} Tabs, 32 keystrokes, 32 swatch clicks); pointer at window middle; wheel(middle, +-3.0) alternating, 60 Hz ticks of 16667 us while input::gliding (cap 60). scale {scale}.\nTick 0 is the state right after the wheel event + settle, before any tick.\n{summary}"
+        ),
+    );
+}
