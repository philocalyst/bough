+        "  primitives_emitted={} primitives_culled={} bounds_tree_inserts={} chunks_reencoded={}",
+        opened.primitives_emitted, opened.primitives_culled, opened.bounds_tree_inserts, opened.chunks_reencoded
+    );
+    let centres = crate::inspect::swatch_centres(window);
+    let _ = writeln!(
+        meta,
+        "swatch centres (34x34 boxes, CSS px, sorted by x): {}",
+        centres
+            .iter()
+            .map(|p| format!("({:.2},{:.2})", p.x.0, p.y.0))
+            .collect::<Vec<_>>()
+            .join(" ")
+    );
+    if which == "shell" {
+        for index in 0..shell::TRIGGERS {
+            let c = shell::centre(&harness, &format!("tip-{index}"));
+            let _ = writeln!(meta, "tip-{index} centre (CSS px): ({:.2},{:.2})", c.x.0, c.y.0);
+        }
+        let c = shell::centre(&harness, "dock-handle");
+        let _ = writeln!(meta, "dock-handle centre (CSS px): ({:.2},{:.2})", c.x.0, c.y.0);
+    }
+    let window = &harness.app().windows()[0];
+    let position = window.host().scroll_position(root);
+    let _ = writeln!(
+        meta,
+        "root element scroll extent (device px): content {:.0}x{:.0}, scrollport {:.0}x{:.0}, offset ({:.0},{:.0})",
+        position.content_size.width.0,
+        position.content_size.height.0,
+        position.scrollport.width.0,
+        position.scrollport.height.0,
+        position.offset.x.0,
+        position.offset.y.0,
+    );
+    let _ = writeln!(
+        meta,
+        "document extent (furthest element box right/bottom, device px): {:.0} x {:.0}",
+        doc.extent.0, doc.extent.1
+    );
+    let _ = writeln!(meta, "scroll containers ({}):", doc.scrollers.len());
+    for line in &doc.scrollers {
+        let _ = writeln!(meta, "  {line}");
+    }
+
+    // A full repaint at a different width, for the cost of drawing everything once more.
+    {
+        let before = zgui_profile::counter::snapshot();
+        harness.deliver_to_first(zgui::platform::SurfaceEvent::Resized(zgui::geom::Size::new(
+            zgui::geom::DevicePx(crate::gallery::WIDTH + 8.0),
+            zgui::geom::DevicePx(crate::gallery::HEIGHT),
+        )));
+        harness.settle(64);
+        let moved = before.delta(&zgui_profile::counter::snapshot());
+        let _ = writeln!(
+            meta,
+            "one resize step (+8 px width) from rest: primitives_emitted={} culled={} scene ops after={} boxes_rebuilt={} nodes_relaid_out={}",
+            moved.primitives_emitted,
+            moved.primitives_culled,
+            harness.app().windows()[0].scene().ops().len(),
+            moved.boxes_rebuilt,
+            moved.nodes_relaid_out
+        );
+        harness.deliver_to_first(zgui::platform::SurfaceEvent::Resized(zgui::geom::Size::new(
+            zgui::geom::DevicePx(crate::gallery::WIDTH),
+            zgui::geom::DevicePx(crate::gallery::HEIGHT),
+        )));
+        harness.settle(64);
+    }
+
+    // Tab traversal to a text field, exactly as the kitchen scenario does it.
+    let (tabs_needed, costs) = crate::input::focus_a_field_timed(&mut harness);
+    let window = &harness.app().windows()[0];
+    let focused = {
+        use zgui::prelude::GetUntracked;
+        window.host().focused().get_untracked()
+    };
+    let _ = writeln!(
+        meta,
+        "focus_a_field_timed: {tabs_needed} Tab presses (loop stops at 400 if no text field is reached); input::typing={}; median press {:.1} us",
+        crate::input::typing(&harness),
+        {
+            let mut c = costs.clone();
+            c.sort_by(f64::total_cmp);
+            c.get(c.len() / 2).copied().unwrap_or(0.0)
+        }
+    );
+    match focused.and_then(zgui_view_dom::id::to_document) {
+        Some(key) => {
+            let pre = doc.index_of.get(&key).copied();
+            let label = pre.map(|p| doc.labels[p].clone());
+            let _ = writeln!(
+                meta,
+                "ends on: preorder={pre:?} testid/classes/tag={label:?} (tab_stop index in the order above: {:?})",
+                focusables
+                    .iter()
+                    .position(|node| zgui_view_dom::id::to_document(*node) == Some(key))
+            );
+        }
+        None => {
+            let _ = writeln!(meta, "ends on: nothing focused");
+        }
+    }
+    write(&format!("{file}.meta.txt"), &meta);
+}
