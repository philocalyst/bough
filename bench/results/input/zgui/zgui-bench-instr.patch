+fn glide_scroll() {
+    let mut harness = crate::drive::harness(fixture::runtime(Fixture::LongList));
+    quiet(&mut harness);
+    let middle = Point::new(
+        CssPx(crate::gallery::WIDTH / 2.0),
+        CssPx(crate::gallery::HEIGHT / 2.0),
+    );
+    harness.deliver_to_first(crate::input::pointer(PointerAction::Moved, middle));
+    harness.settle(64);
+    let key = biggest_scroller(&harness.app().windows()[0]).expect("the list scrolls");
+    let scale = harness.app().windows()[0].scale().get();
+
+    let mut tsv = String::from("tick\tkind\toffset_y_device_px\toffset_y_css_px\toffset_x\tframes_run\tboxes_rebuilt\tnodes_relaid_out\tprimitives_emitted\tgliding_after\n");
+    let _ = writeln!(
+        tsv,
+        "-1\tstart\t{:.4}\t{:.4}\t{:.4}\t0\t0\t0\t0\t{}",
+        offset_y(&harness, key).1,
+        offset_y(&harness, key).1 / scale,
+        offset_y(&harness, key).0,
+        u8::from(crate::input::gliding(&harness))
+    );
+    for tick in 0..120 {
+        let mark = zgui_profile::counter::snapshot();
+        let (kind, ran) = if tick % 40 == 0 {
+            harness.deliver_to_first(crate::input::wheel(middle, 6.0));
+            let settled = harness.settle(64);
+            harness.advance(Duration::from_micros(8_333));
+            ("notch", settled as u64 + harness.pump() as u64)
+        } else {
+            harness.advance(Duration::from_micros(8_333));
+            ("tick", harness.pump() as u64)
+        };
+        let moved = mark.delta(&zgui_profile::counter::snapshot());
+        let (x, y) = offset_y(&harness, key);
+        let _ = writeln!(
+            tsv,
+            "{tick}\t{kind}\t{y:.4}\t{:.4}\t{x:.4}\t{ran}\t{}\t{}\t{}\t{}",
+            y / scale,
+            moved.boxes_rebuilt,
+            moved.nodes_relaid_out,
+            moved.primitives_emitted,
+            u8::from(crate::input::gliding(&harness))
+        );
+    }
+    write("glide_scroll.tsv", &tsv);
+    let settings = harness.app().windows()[0].scroll_settings();
+    write(
+        "glide_scroll.meta.txt",
+        &format!(
+            "LongList fixture ({} rows of {} px), pointer at window middle ({}, {}), wheel(middle, 6.0) every 40 ticks, 120 Hz ticks of 8333 us, first 3 notches.\nscale {scale}; scroll settings: lines_per_notch={} direction={:?}\n",
+            fixture::LIST_ROWS,
+            fixture::LIST_ROW_HEIGHT,
+            middle.x.0,
+            middle.y.0,
+            settings.lines_per_notch,
+            settings.direction
+        ),
+    );
+}
+
+/// Whatever container the scroller has displaced, the one displaced furthest first.
+fn moving(window: &Window) -> Vec<(NodeKey, f32, f32)> {
+    let mut found: Vec<(NodeKey, f32, f32)> = window
+        .scroll()
+        .borrow()
+        .composed()
+        .iter()
+        .filter(|(_, at)| at.x.0 != 0.0 || at.y.0 != 0.0)
+        .map(|(key, at)| (key, at.x.0, at.y.0))
+        .collect();
+    found.sort_by(|a, b| b.2.abs().total_cmp(&a.2.abs()));
+    found
+}
+
+fn describe(window: &Window, key: NodeKey) -> String {
+    let document = window.document().borrow();
+    let store = document.store();
+    let Some(index) = store.index_of(key) else {
+        return "?".to_owned();
+    };
+    let classes: Vec<String> = store
+        .classes_of(index)
+        .iter()
+        .map(|class| class.0.as_ref().to_owned())
+        .collect();
+    format!(
+        "{}[{}]",
+        document.node(index).record().local_name().as_str(),
+        classes.join(" ")
+    )
+}
+
+/// The container the scroller has displaced furthest: its description and offset.
+fn lead(harness: &Harness<Runtime>) -> (String, f32) {
+    let window = &harness.app().windows()[0];
+    match moving(window).first() {
+        Some((key, _, y)) => (describe(window, *key), *y),
+        None => ("-".to_owned(), 0.0),
+    }
+}
