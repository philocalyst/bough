+    harness.settle(64);
+    let mut drag = String::from("step\tpointer_y_css\tframes_run\tpanel0_h\tpanel1_h\tpanel0_y\tpanel1_y\tboxes_rebuilt\tnodes_relaid_out\tprimitives_emitted\n");
