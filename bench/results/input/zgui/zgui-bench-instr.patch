+        }
+    }
+    write(&format!("{file}.tabs.tsv"), &tabs);
+
+    // Meta.
+    let mut meta = String::new();
+    let (boxes, fragments) = crate::inspect::document(window);
+    let _ = writeln!(meta, "document: {which} ({}x{} CSS px, scale {})", crate::gallery::WIDTH, crate::gallery::HEIGHT, window.scale().get());
+    let _ = writeln!(meta, "layout boxes (window.layout().keys().len()): {boxes}");
+    let _ = writeln!(meta, "fragments (inspect::document): {fragments}");
+    let _ = writeln!(
+        meta,
+        "dom nodes emitted to TSV: {} elements + {} text nodes = {} rows; {} markers skipped; max depth {}",
+        doc.elements,
+        doc.texts,
+        doc.rows.len(),
+        doc.markers,
+        doc.max_depth
+    );
+    let _ = writeln!(meta, "document store len: {}", window.document().borrow().len());
+    let _ = writeln!(
+        meta,
+        "focusable elements in tab order (host.focusables(root)): {}",
+        focusables.len()
+    );
+    let _ = writeln!(
+        meta,
+        "primitives in the display list after the first frame (scene.ops().len()): {first_frame_ops}"
+    );
+    let _ = writeln!(
+        meta,
+        "counters moved by opening the window + first frame (nonzero only): {opened:?}"
