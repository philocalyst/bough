diff -ruN a/crates/zgui-bench/src/dump.rs b/crates/zgui-bench/src/dump.rs
--- a/crates/zgui-bench/src/dump.rs	1969-12-31 16:00:00
+++ b/crates/zgui-bench/src/dump.rs	2026-11-01 05:23:29
@@ -0,0 +1,1072 @@
+//! The `dump` phase: writes the documents the scenarios drive, and the motion curves they take, as
+//! TSV, so another framework's document can be compared with them element by element.
+//!
+//! Usage: `ZGUI_DUMP_DIR=<dir> zgui-bench dump <s13|shell|table|glide_scroll|glide_kitchen|shell_motion>`.
+//! Each runs in its own process because a document mounted on a thread that has mounted another
+//! is a document whose caches are somebody else's.
+
+use std::collections::HashMap;
+use std::fmt::Write as _;
+use std::path::PathBuf;
+use std::time::Duration;
+
+use zgui::geom::{CssPx, Point};
+use zgui::prelude::*;
+use zgui::runtime::{Runtime, Window};
+use zgui::view::{AttrName, NodeId, ViewHost};
+use zgui::vocab::PointerAction;
+use zgui_dom::{NodeKey, NodeKind};
+use zgui_platform_headless::Harness;
+
+use crate::scenario::fixture::{self, Fixture};
+use crate::scenario::{quiet, shell};
+
+fn out_dir() -> PathBuf {
+    let dir = PathBuf::from(
+        std::env::var("ZGUI_DUMP_DIR").expect("ZGUI_DUMP_DIR names the output directory"),
+    );
+    std::fs::create_dir_all(&dir).expect("the output directory can be made");
+    dir
+}
+
+fn write(name: &str, text: &str) {
+    let path = out_dir().join(name);
+    std::fs::write(&path, text).unwrap_or_else(|error| panic!("{}: {error}", path.display()));
+    eprintln!("wrote {}", path.display());
+}
+
+pub(crate) fn run(what: &str) {
+    match what {
+        "s13" => document("gallery_s13", "s13"),
+        "shell" => document("shell", "shell"),
+        "table" => document("table", "table"),
+        "glide_scroll" => glide_scroll(),
+        "glide_kitchen" => glide_kitchen(),
+        "shell_motion" => shell_motion(),
+        other => panic!("unknown dump `{other}`"),
+    }
+}
+
+// ---------------------------------------------------------------------------------------------
+// Colours
+
+/// `rgb(…)`/`rgba(…)` as `#rrggbbaa`; anything else is passed through.
+fn hex(value: &str) -> String {
+    let value = value.trim();
+    let Some(open) = value.find('(') else {
+        return value.to_owned();
+    };
+    let name = &value[..open];
+    if name == "oklch" || name == "oklab" {
+        let inner = value[open + 1..].trim_end_matches(')');
+        let parts: Vec<f32> = inner
+            .split([' ', '/'])
+            .filter(|part| !part.is_empty())
+            .filter_map(|part| part.parse::<f32>().ok())
+            .collect();
+        if parts.len() < 3 {
+            return value.to_owned();
+        }
+        let (l, a, b) = if name == "oklch" {
+            let hue = parts[2].to_radians();
+            (parts[0], parts[1] * hue.cos(), parts[1] * hue.sin())
+        } else {
+            (parts[0], parts[1], parts[2])
+        };
+        let alpha = parts.get(3).copied().unwrap_or(1.0);
+        let l_ = (l + 0.396_337_78 * a + 0.215_803_76 * b).powi(3);
+        let m_ = (l - 0.105_561_346 * a - 0.063_854_17 * b).powi(3);
+        let s_ = (l - 0.089_484_18 * a - 1.291_485_5 * b).powi(3);
+        let linear = [
+            4.076_741_7 * l_ - 3.307_711_6 * m_ + 0.230_969_94 * s_,
+            -1.268_438 * l_ + 2.609_757_4 * m_ - 0.341_319_4 * s_,
+            -0.004_196_086 * l_ - 0.703_418_6 * m_ + 1.707_614_7 * s_,
+        ];
+        let gamma = |v: f32| {
+            let v = v.clamp(0.0, 1.0);
+            if v <= 0.003_130_8 { 12.92 * v } else { 1.055 * v.powf(1.0 / 2.4) - 0.055 }
+        };
+        #[expect(clippy::cast_possible_truncation, clippy::cast_sign_loss, reason = "clamped")]
+        let byte = |v: f32| (v * 255.0).round().clamp(0.0, 255.0) as u8;
+        return format!(
+            "#{:02x}{:02x}{:02x}{:02x}",
+            byte(gamma(linear[0])),
+            byte(gamma(linear[1])),
+            byte(gamma(linear[2])),
+            byte(alpha)
+        );
+    }
+    if name != "rgb" && name != "rgba" {
+        return value.to_owned();
+    }
+    let inner = value[open + 1..].trim_end_matches(')');
+    let parts: Vec<f32> = inner
+        .split([',', ' ', '/'])
+        .filter(|part| !part.is_empty())
+        .filter_map(|part| {
+            if let Some(percent) = part.strip_suffix('%') {
+                percent.parse::<f32>().ok().map(|p| p / 100.0)
+            } else {
+                part.parse::<f32>().ok()
+            }
+        })
+        .collect();
+    if parts.len() < 3 {
+        return value.to_owned();
+    }
+    let alpha = parts.get(3).copied().unwrap_or(1.0);
+    #[expect(clippy::cast_possible_truncation, clippy::cast_sign_loss, reason = "clamped")]
+    let byte = |v: f32| v.round().clamp(0.0, 255.0) as u8;
+    format!(
+        "#{:02x}{:02x}{:02x}{:02x}",
+        byte(parts[0]),
+        byte(parts[1]),
+        byte(parts[2]),
+        byte(alpha * 255.0)
+    )
+}
+
+// ---------------------------------------------------------------------------------------------
+// The document walk
+
+/// The properties given a column of their own, in the order the columns appear.
+const NAMED: &[(&str, &str)] = &[
+    ("display", "display"),
+    ("position", "position"),
+    ("flex_direction", "flex-direction"),
+    ("flex_wrap", "flex-wrap"),
+    ("flex_grow", "flex-grow"),
+    ("flex_shrink", "flex-shrink"),
+    ("flex_basis", "flex-basis"),
+    ("width", "width"),
+    ("height", "height"),
+    ("min_width", "min-width"),
+    ("min_height", "min-height"),
+    ("max_width", "max-width"),
+    ("max_height", "max-height"),
+    ("padding_t", "padding-top"),
+    ("padding_r", "padding-right"),
+    ("padding_b", "padding-bottom"),
+    ("padding_l", "padding-left"),
+    ("margin_t", "margin-top"),
+    ("margin_r", "margin-right"),
+    ("margin_b", "margin-bottom"),
+    ("margin_l", "margin-left"),
+    ("row_gap", "row-gap"),
+    ("column_gap", "column-gap"),
+    ("align_items", "align-items"),
+    ("align_self", "align-self"),
+    ("justify_content", "justify-content"),
+    ("overflow_x", "overflow-x"),
+    ("overflow_y", "overflow-y"),
+    ("box_sizing", "box-sizing"),
+    ("grid_template_columns", "grid-template-columns"),
+    ("grid_column_start", "grid-column-start"),
+    ("grid_column_end", "grid-column-end"),
+    ("bg_color", "background-color"),
+    ("bg_image", "background-image"),
+    ("border_w_t", "border-top-width"),
+    ("border_w_r", "border-right-width"),
+    ("border_w_b", "border-bottom-width"),
+    ("border_w_l", "border-left-width"),
+    ("border_s_t", "border-top-style"),
+    ("border_c_t", "border-top-color"),
+    ("border_c_r", "border-right-color"),
+    ("border_c_b", "border-bottom-color"),
+    ("border_c_l", "border-left-color"),
+    ("radius_tl", "border-top-left-radius"),
+    ("radius_tr", "border-top-right-radius"),
+    ("radius_br", "border-bottom-right-radius"),
+    ("radius_bl", "border-bottom-left-radius"),
+    ("opacity", "opacity"),
+    ("box_shadow", "box-shadow"),
+    ("outline_style", "outline-style"),
+    ("outline_width", "outline-width"),
+    ("outline_color", "outline-color"),
+    ("font_size", "font-size"),
+    ("font_weight", "font-weight"),
+    ("font_family", "font-family"),
+    ("color", "color"),
+    ("line_height", "line-height"),
+    ("text_align", "text-align"),
+    ("white_space", "white-space"),
+    ("z_index", "z-index"),
+    ("transform", "transform"),
+    ("animation_name", "animation-name"),
+    ("animation_duration", "animation-duration"),
+    ("transition_property", "transition-property"),
+    ("transition_duration", "transition-duration"),
+    ("cursor", "cursor"),
+    ("pointer_events", "pointer-events"),
+];
+
+/// Columns that are colours, and are written as hex.
+fn is_colour(css: &str) -> bool {
+    css.ends_with("color")
+}
+
+struct Doc {
+    rows: Vec<String>,
+    /// Preorder index of each emitted node, by key.
+    index_of: HashMap<NodeKey, usize>,
+    /// What each row is, for the report: (preorder, testid, classes).
+    labels: Vec<(String, String, String)>,
+    elements: usize,
+    texts: usize,
+    markers: usize,
+    max_depth: usize,
+    scrollers: Vec<String>,
+    /// The right and bottom edge of the furthest element box, device px.
+    extent: (f32, f32),
+}
+
+fn clean(text: &str) -> String {
+    text.replace(['\t', '\n', '\r'], " ")
+}
+
+fn rect_cols(rect: Option<zgui::geom::Rect<zgui::geom::DevicePx, zgui::geom::Device>>) -> String {
+    match rect {
+        Some(rect) => format!(
+            "{:.2}\t{:.2}\t{:.2}\t{:.2}",
+            rect.origin.x.0, rect.origin.y.0, rect.size.width.0, rect.size.height.0
+        ),
+        None => "\t\t\t".to_owned(),
+    }
+}
+
+fn walk(window: &Window, focusables: &[NodeId]) -> Doc {
+    let document = window.document().borrow();
+    let dom = window.dom();
+    let host = window.host();
+    let layout = window.layout().borrow();
+    let store = document.store();
+    let testid = AttrName::new("data-testid");
+    let tabindex = AttrName::new("tabindex");
+
+    let tab_of: HashMap<NodeKey, usize> = focusables
+        .iter()
+        .enumerate()
+        .filter_map(|(at, node)| zgui_view_dom::id::to_document(*node).map(|key| (key, at)))
+        .collect();
+
+    // The initial value of every longhand, once, so a node's "other" column lists only what
+    // somebody (or the theme) set.
+    let initial = zgui_css::StyleDraft::initial().build();
+    let longhands = zgui_css::parity::catalog::canonical_longhands();
+    let initial_values: Vec<Option<String>> = longhands
+        .iter()
+        .map(|name| zgui_css::parity::observe::computed_value(&initial, name))
+        .collect();
+    let named: std::collections::HashSet<&str> = NAMED.iter().map(|(_, css)| *css).collect();
+
+    let mut doc = Doc {
+        rows: Vec::new(),
+        index_of: HashMap::new(),
+        labels: Vec::new(),
+        elements: 0,
+        texts: 0,
+        markers: 0,
+        max_depth: 0,
+        scrollers: Vec::new(),
+        extent: (0.0, 0.0),
+    };
+
+    let mut stack: Vec<(zgui_dom::NodeIndex, usize)> = Vec::new();
+    {
+        let mut children = Vec::new();
+        let mut next = store.core(document.document_index()).first_child();
+        while let Some(child) = next {
+            children.push(child);
+            next = store.core(child).next_sibling();
+        }
+        for child in children.into_iter().rev() {
+            stack.push((child, 0));
+        }
+    }
+    // The nearest ancestor element's style, for the text nodes under it.
+    let mut parent_style: HashMap<zgui_dom::NodeIndex, zgui_css::ComputedStyle> = HashMap::new();
+
+    while let Some((index, depth)) = stack.pop() {
+        let record = document.node(index);
+        let kind = record.kind();
+        let key = store.key_of(index);
+        let id = zgui_view_dom::id::to_view(key);
+
+        // children first (so the stack is right), regardless of what this node is
+        let mut children = Vec::new();
+        let mut next = store.core(index).first_child();
+        while let Some(child) = next {
+            children.push(child);
+            next = store.core(child).next_sibling();
+        }
+
+        let style = match kind {
+            NodeKind::Element => record.primary_style(),
+            NodeKind::Text => {
+                // The text inherits its parent's style.
+                let parent = store.core(index).parent();
+                parent.and_then(|parent| parent_style.get(&parent).cloned())
+            }
+            _ => None,
+        };
+        if kind == NodeKind::Element {
+            if let Some(style) = &style {
+                parent_style.insert(index, style.clone());
+            }
+        }
+        let child_depth = match kind {
+            NodeKind::Element | NodeKind::Text => depth + 1,
+            _ => depth,
+        };
+        for child in children.into_iter().rev() {
+            stack.push((child, child_depth));
+        }
+
+        let (kind_name, tag) = match kind {
+            NodeKind::Element => ("element", record.record().local_name().as_str().to_owned()),
+            NodeKind::Text => ("text", "#text".to_owned()),
+            NodeKind::Marker => {
+                doc.markers += 1;
+                continue;
+            }
+            _ => continue,
+        };
+
+        let preorder = doc.rows.len();
+        doc.index_of.insert(key, preorder);
+        doc.max_depth = doc.max_depth.max(depth);
+        if kind == NodeKind::Element {
+            doc.elements += 1;
+        } else {
+            doc.texts += 1;
+        }
+
+        let classes: Vec<String> = store
+            .classes_of(index)
+            .iter()
+            .map(|class| class.0.as_ref().to_owned())
+            .collect();
+        let classes = classes.join(" ");
+        let (test_id, elem_id) = if kind == NodeKind::Element {
+            (
+                dom.attribute(id, testid).unwrap_or_default(),
+                record
+                    .record()
+                    .id_attr()
+                    .map(|id| id.to_string())
+                    .unwrap_or_default(),
+            )
+        } else {
+            (String::new(), String::new())
+        };
+
+        let boxes = layout.boxes_of(key);
+        let fragments: usize = boxes
+            .iter()
+            .map(|b| layout.fragments_of_box(*b).len())
+            .sum();
+        let window_box = host.window_box(id);
+        if kind == NodeKind::Element {
+            if let Some(rect) = window_box {
+                doc.extent.0 = doc.extent.0.max(rect.origin.x.0 + rect.size.width.0);
+                doc.extent.1 = doc.extent.1.max(rect.origin.y.0 + rect.size.height.0);
+            }
+        }
+
+        let mut row = String::new();
+        let _ = write!(
+            row,
+            "{preorder}\t{depth}\t{kind_name}\t{tag}\t{}\t{}\t{}\t{}\t{}\t{}",
+            clean(&classes),
+            clean(&test_id),
+            clean(&elem_id),
+            rect_cols(window_box),
+            boxes.len(),
+            fragments,
+        );
+
+        // computed style columns
+        let mut other = String::new();
+        for (_, css) in NAMED {
+            let value = style
+                .as_ref()
+                .and_then(|style| zgui_css::parity::observe::computed_value(style, css))
+                .unwrap_or_default();
+            let value = if is_colour(css) { hex(&value) } else { value };
+            let _ = write!(row, "\t{}", clean(&value));
+        }
+        if kind == NodeKind::Element {
+            if let Some(style) = &style {
+                for (name, init) in longhands.iter().zip(&initial_values) {
+                    if named.contains(name.as_str())
+                        || name.contains("block")
+                        || name.contains("inline")
+                    {
+                        continue;
+                    }
+                    let value = zgui_css::parity::observe::computed_value(style, name);
+                    if value != *init {
+                        if let Some(value) = value {
+                            let value = if is_colour(name) { hex(&value) } else { value };
+                            let _ = write!(other, "{name}:{};", clean(&value));
+                        }
+                    }
+                }
+            }
+        }
+
+        // text
+        let text = if kind == NodeKind::Text {
+            clean(&dom.text_content(id))
+        } else {
+            String::new()
+        };
+        let _ = write!(row, "\t{text}");
+
+        // interaction
+        let flags = record.record().flags();
+        let focusable = flags.contains(zgui_dom::NodeFlags::FOCUSABLE);
+        let tab = tab_of.get(&key).map(ToString::to_string).unwrap_or_default();
+        let tab_attr = if kind == NodeKind::Element {
+            dom.attribute(id, tabindex).unwrap_or_default()
+        } else {
+            String::new()
+        };
+        let listeners: Vec<String> = store
+            .columns()
+            .listeners
+            .get(key)
+            .map(|set| set.iter().map(|l| format!("{:?}", l.kind)).collect())
+            .unwrap_or_default();
+        let semantics = if kind == NodeKind::Element {
+            dom.semantics(id)
+        } else {
+            None
+        };
+        let role = semantics
+            .as_ref()
+            .map(|s| format!("{:?}", s.role))
+            .unwrap_or_default();
+        let label = semantics
+            .as_ref()
+            .and_then(|s| s.label.as_ref().map(ToString::to_string))
+            .unwrap_or_default();
+        let editable = matches!(role.as_str(), "TextInput" | "TextField" | "TextBox" | "MultilineTextInput" | "SearchInput" | "PasswordInput")
+            || matches!(tag.as_str(), "input" | "textarea");
+        let _ = write!(
+            row,
+            "\t{}\t{tab}\t{}\t{}\t{}\t{}\t{}",
+            u8::from(focusable),
+            clean(&tab_attr),
+            u8::from(editable),
+            clean(&listeners.join(",")),
+            clean(&role),
+            clean(&label),
+        );
+
+        // scroll
+        let region = boxes
+            .first()
+            .and_then(|first| zgui_layout::scroll_region::region_of(&layout, *first));
+        match region {
+            Some(region) => {
+                let position = host.scroll_position(id);
+                let _ = write!(
+                    row,
+                    "\t1\t{:.2}\t{:.2}\t{:.2}\t{:.2}\t{:.2}\t{:.2}\t{}\t{}",
+                    region.content.width.0,
+                    region.content.height.0,
+                    region.scrollport.size.width.0,
+                    region.scrollport.size.height.0,
+                    position.offset.x.0,
+                    position.offset.y.0,
+                    u8::from(region.scrolls_x),
+                    u8::from(region.scrolls_y),
+                );
+                doc.scrollers.push(format!(
+                    "preorder={preorder} tag={tag} testid={test_id} classes=[{classes}] content={:.0}x{:.0} port={:.0}x{:.0} scrolls_x={} scrolls_y={}",
+                    region.content.width.0,
+                    region.content.height.0,
+                    region.scrollport.size.width.0,
+                    region.scrollport.size.height.0,
+                    region.scrolls_x,
+                    region.scrolls_y,
+                ));
+            }
+            None => row.push_str("\t0\t\t\t\t\t\t\t\t"),
+        }
+
+        let running = if kind == NodeKind::Element {
+            host.running_animations(id)
+        } else {
+            0
+        };
+        let _ = write!(row, "\t{running}\t{}", clean(&other));
+
+        doc.labels.push((test_id, classes, tag));
+        doc.rows.push(row);
+    }
+    doc
+}
