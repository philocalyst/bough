+    let first_frame_ops = harness.app().windows()[0].scene().ops().len();
+    quiet(&mut harness);
+
+    let window = &harness.app().windows()[0];
+    let root = window.dom().root_node();
+    let focusables = window.host().focusables(root);
+
+    let doc = walk(window, &focusables);
+    let mut text = header();
+    text.push('\n');
+    for row in &doc.rows {
+        text.push_str(row);
+        text.push('\n');
+    }
+    write(&format!("{file}.tsv"), &text);
+
+    // Tab order.
+    let mut tabs = String::from("tab_stop\tpreorder\ttestid\ttag\tclasses\n");
+    for (at, node) in focusables.iter().enumerate() {
+        if let Some(key) = zgui_view_dom::id::to_document(*node) {
+            if let Some(pre) = doc.index_of.get(&key) {
+                let (t, c, tag) = &doc.labels[*pre];
+                let _ = writeln!(tabs, "{at}\t{pre}\t{t}\t{tag}\t{c}");
