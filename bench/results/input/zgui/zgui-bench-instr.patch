+// Scroll physics
+
+/// The scroll container with the most to scroll, found by looking, not by name.
+fn biggest_scroller(window: &Window) -> Option<NodeKey> {
+    let document = window.document().borrow();
+    let layout = window.layout().borrow();
+    let store = document.store();
+    let mut best: Option<(f32, NodeKey)> = None;
+    let mut stack = vec![document.document_index()];
+    while let Some(index) = stack.pop() {
+        let key = store.key_of(index);
+        if let Some(first) = layout.boxes_of(key).first() {
+            if let Some(region) = zgui_layout::scroll_region::region_of(&layout, *first) {
+                let extra = region.content.height.0 - region.scrollport.size.height.0;
+                if extra > 1.0 && best.is_none_or(|(b, _)| extra > b) {
+                    best = Some((extra, key));
+                }
+            }
+        }
+        let mut next = store.core(index).first_child();
+        while let Some(child) = next {
+            stack.push(child);
+            next = store.core(child).next_sibling();
+        }
+    }
+    best.map(|(_, key)| key)
+}
