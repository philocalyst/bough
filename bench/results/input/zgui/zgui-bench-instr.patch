diff -ruN a/crates/zgui-bench/src/instr.rs b/crates/zgui-bench/src/instr.rs
--- a/crates/zgui-bench/src/instr.rs	1969-12-31 16:00:00
+++ b/crates/zgui-bench/src/instr.rs	2026-11-01 05:10:33
@@ -0,0 +1,105 @@
+//! Process-wide retired instructions, read from the kernel (macOS `proc_pid_rusage`).
+//!
+//! Added for the bough/zgui comparison: every span the scenarios time is also counted in
+//! instructions, so a number can be compared across machines and across load.
+
+#![allow(unsafe_code, reason = "one FFI call into libproc")]
+
+use std::cell::RefCell;
+use std::sync::OnceLock;
+
+/// Retired instructions of the whole process (every thread, user and kernel as the OS accounts).
+#[must_use]
+pub fn now() -> u64 {
+    let mut info = core::mem::MaybeUninit::<libc::rusage_info_v4>::zeroed();
+    // SAFETY: `info` is a correctly sized, writable rusage_info_v4 and the pid is our own.
+    let rc = unsafe {
+        libc::proc_pid_rusage(
+            libc::getpid(),
+            libc::RUSAGE_INFO_V4,
+            info.as_mut_ptr().cast::<libc::rusage_info_t>(),
+        )
+    };
+    assert_eq!(rc, 0, "proc_pid_rusage failed");
+    // SAFETY: the call succeeded, so the struct is initialised.
+    unsafe { info.assume_init() }.ri_instructions
+}
+
+/// What an empty measured span costs: `now()`, the stopwatch start and read, then the closing read.
+/// Calibrated once, with the same shape the scenarios use, and subtracted by [`since`].
+fn overhead() -> u64 {
+    static OVERHEAD: OnceLock<u64> = OnceLock::new();
+    *OVERHEAD.get_or_init(|| {
+        let mut costs: Vec<u64> = (0..6_000)
+            .map(|_| {
+                let start = now();
+                let stopwatch = std::time::Instant::now();
+                core::hint::black_box(stopwatch.elapsed());
+                now().saturating_sub(start)
+            })
+            .skip(1_000)
+            .collect();
+        costs.sort_unstable();
+        costs[costs.len() / 2]
+    })
+}
+
+/// Instructions since `start` (a value from [`now`]), minus the calibrated cost of the read itself.
+#[must_use]
+pub fn since(start: u64) -> f64 {
+    let spent = now().saturating_sub(start);
+    spent.saturating_sub(overhead()) as f64
+}
+
+/// The calibrated per-read overhead, for the report.
+#[must_use]
+pub fn read_overhead() -> u64 {
+    overhead()
+}
+
+thread_local! {
+    static LEDGER: RefCell<Vec<(String, Vec<f64>)>> = const { RefCell::new(Vec::new()) };
+}
+
+/// Files one sample of instructions under a measurement's name.
+pub fn record(name: &str, instructions: f64) {
+    LEDGER.with(|ledger| {
+        let mut ledger = ledger.borrow_mut();
+        if let Some((_, samples)) = ledger.iter_mut().find(|(n, _)| n == name) {
+            samples.push(instructions);
+        } else {
+            ledger.push((name.to_owned(), vec![instructions]));
+        }
+    });
+}
+
+/// `(p10, p50, p90, n)` of the samples filed under `name`, if any.
+#[must_use]
+pub fn quantiles(name: &str) -> Option<(f64, f64, f64, usize)> {
+    LEDGER.with(|ledger| {
+        let ledger = ledger.borrow();
+        let (_, samples) = ledger.iter().find(|(n, _)| n == name)?;
+        let mut sorted = samples.clone();
+        sorted.sort_by(f64::total_cmp);
+        let at = |fraction: f64| {
+            let index = (((sorted.len() - 1) as f64) * fraction).round() as usize;
+            sorted[index.min(sorted.len() - 1)]
+        };
+        Some((at(0.10), at(0.50), at(0.90), sorted.len()))
+    })
+}
+
+/// The median of `name`'s samples.
+#[must_use]
+pub fn p50(name: &str) -> f64 {
+    quantiles(name).map_or(0.0, |(_, p50, _, _)| p50)
+}
+
+/// The `INSTR` line for one measurement, if it has samples.
+#[must_use]
+pub fn line(scenario: &str, name: &str) -> Option<String> {
+    let (p10, p50, p90, n) = quantiles(name)?;
+    Some(format!(
+        "INSTR {scenario} {name} p50={p50:.0} p10={p10:.0} p90={p90:.0} n={n}"
+    ))
+}
