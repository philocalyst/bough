+        let _ = writeln!(
+            drag,
+            "{step}\t{y:.2}\t{ran}\t{:.2}\t{:.2}\t{:.2}\t{:.2}\t{}\t{}\t{}",
+            now[0].1, now[1].1, now[0].0, now[1].0, moved.boxes_rebuilt, moved.nodes_relaid_out, moved.primitives_emitted
+        );
+    }
+    harness.deliver_to_first(shell::primary(
+        PointerAction::Released,
+        Point::new(start.x, CssPx(y)),
+    ));
+    harness.settle(64);
+    write("shell_drag.tsv", &drag);
+    let _ = panel_heights(&harness);
+    let _ = writeln!(
+        meta,
+        "drag: {} steps of {} px (first half up, second half down) from the dock-handle centre; see shell_drag.tsv and tooltip_sweep.tsv",
+        shell::DRAG_STEPS,
+        shell::DRAG_STEP
+    );
+    write("shell_motion.meta.txt", &meta);
+}
