+        "-1\t{:.2}\t0\t{:.2}\t{:.2}\t{:.2}\t{:.2}\t0\t0\t0",
+        start.y.0, at_rest[0].1, at_rest[1].1, at_rest[0].0, at_rest[1].0
+    );
+    let mut y = start.y.0;
+    for step in 0..shell::DRAG_STEPS {
+        y += if step < shell::DRAG_STEPS / 2 { -shell::DRAG_STEP } else { shell::DRAG_STEP };
