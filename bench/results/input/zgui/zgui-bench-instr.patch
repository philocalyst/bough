+        harness.deliver_to_first(crate::input::pointer(
+            PointerAction::Moved,
+            Point::new(start.x, CssPx(y)),
+        ));
+        let ran = harness.settle(64);
+        let moved = mark.delta(&zgui_profile::counter::snapshot());
+        harness.advance(Duration::from_micros(8_333));
